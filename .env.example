# Copie para .env antes de rodar:  cp .env.example .env
#
# Postgres hospedado (Vercel/Neon). O schema do Prisma lê estas duas variáveis:
#  - POSTGRES_PRISMA_URL:      conexão COM pooling (porta -pooler), usada pelo app.
#  - POSTGRES_URL_NON_POOLING: conexão DIRETA, usada por migrations / db push / seed.
#
# Em produção, a integração Neon da Vercel injeta essas variáveis automaticamente.
# Para rodar local, copie os valores do painel do Neon ou rode: vercel env pull .env
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
