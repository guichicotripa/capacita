# Copie para .env antes de rodar:  cp .env.example .env
# Nunca comite o .env preenchido.

# --- Banco (obrigatório) ---------------------------------------------------
# Postgres hospedado (Vercel/Neon). O schema do Prisma lê estas duas variáveis:
#  - POSTGRES_PRISMA_URL:      conexão COM pooling (porta -pooler), usada pelo app.
#  - POSTGRES_URL_NON_POOLING: conexão DIRETA, usada por migrations / db push / seed.
#
# Em produção, a integração Neon da Vercel injeta essas variáveis automaticamente.
# Para rodar local, copie os valores do painel do Neon ou rode: vercel env pull .env
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Sessão (obrigatório em produção) --------------------------------------
# Assina o cookie de sessão. Em dev existe um fallback; em produção, defina.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- IA (opcional) ---------------------------------------------------------
# Sem chave, a plataforma funciona normalmente e só as funções de IA ficam
# indisponíveis, com aviso na tela. Aceita qualquer um dos dois nomes.
ANTHROPIC_API_KEY=""
# ANTHROPIC_KEY=""

# --- Links de convite (recomendado) ----------------------------------------
# Base dos links de primeiro acesso. Sem isso, cai no endereço de produção
# padrão, o que gera links quebrados em ambiente local.
APP_URL="http://localhost:3000"

# --- Email (opcional) ------------------------------------------------------
# Três camadas, nesta ordem: SMTP -> Resend -> simulado. Sem nenhuma delas o
# convite não é enviado, mas o link aparece na tela do admin com botão de
# copiar, então ninguém fica sem acesso.
# Porta 465 = SSL implícito; 587 = STARTTLS. SMTP_SECURE é derivado da porta
# quando não estiver definido.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# SMTP_SECURE="true"

# Alternativa ao SMTP.
RESEND_API_KEY=""

# --- Lembretes automáticos (opcional) --------------------------------------
# Protege a rota /api/cron/lembretes, chamada uma vez por dia pelo agendador.
CRON_SECRET=""
