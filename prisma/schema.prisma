// Schema do banco do Capacita (protótipo).
// Modelo central: um Cliente (empresa) tem Usuarios; Treinamentos sao atribuidos
// a Usuarios com um prazo; ao vencer o prazo sem conclusao, o acesso e cortado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // conexao com pooling (app/serverless)
  directUrl = env("POSTGRES_URL_NON_POOLING") // conexao direta (migrations / db push / seed)
}

model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  // Cadastro da empresa. Opcionais de proposito: clientes antigos foram criados
  // so com nome e nao podem quebrar.
  cnpj         String?
  endereco     String?
  email        String?
  telefone     String?
  responsavel  String? // pessoa de contato na empresa
  usuarios     Usuario[]
  treinamentos Treinamento[]
  criadoEm     DateTime      @default(now())
}

model Usuario {
  id          Int          @id @default(autoincrement())
  nome        String
  email       String       @unique
  senhaHash   String
  papel       String // "admin" | "aluno"
  telefone    String? // contato do usuario
  cargo       String? // cargo/funcao na empresa
  ativo       Boolean  @default(true) // desativado = nao loga e some das listas
  // Convite de primeiro acesso: a pessoa define a propria senha pelo link, em vez
  // de o admin repassar uma senha gerada (que se perdia quando o email nao saia).
  conviteToken    String?   @unique
  conviteExpiraEm DateTime?
  clienteId   Int?
  cliente     Cliente?     @relation(fields: [clienteId], references: [id])
  atribuicoes Atribuicao[]
  mfaSecret   String? // segredo TOTP (base32); setado ao iniciar a ativação
  mfaAtivo    Boolean      @default(false) // 2FA confirmado e exigido no login
  senhaTemporaria Boolean  @default(false) // senha definida pelo admin; força troca no 1º acesso
  falhasLogin Int          @default(0) // tentativas de login malsucedidas consecutivas
  bloqueadoAte DateTime? // login bloqueado até este momento (rate-limit / lockout)
  senhasAnteriores SenhaHistorico[]
  criadoEm    DateTime     @default(now())

  @@index([clienteId])
}

// Histórico de hashes de senha, para impedir reutilização das últimas N.
model SenhaHistorico {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  senhaHash String
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

model Treinamento {
  id          Int          @id @default(autoincrement())
  titulo      String
  descricao   String
  tipo        String // "video" | "texto" | "slides" | "arquivo"
  conteudoUrl String? // URL de embed quando tipo = video
  corpo       String? // texto/markdown simples quando tipo = texto
  clienteId   Int? // null = treinamento global (vale para todos os clientes)
  cliente     Cliente?     @relation(fields: [clienteId], references: [id])
  atribuicoes Atribuicao[]
  perguntas   Pergunta[] // quiz opcional; se houver perguntas, concluir exige passar
  slides      Slide[] // conteudo em slides quando tipo = slides
  arquivo     Arquivo? // PDF/PPTX original quando tipo = arquivo
  notaMinima  Int          @default(70) // % minimo de acerto para concluir
  // Como o conteudo dos slides e apresentado: "topicos" (bullets) ou "prosa"
  // (paragrafos descritivos). Escolhido na geracao por IA.
  formatoConteudo String   @default("topicos")
  geradoPorIa Boolean      @default(false)
  criadoEm    DateTime     @default(now())

  @@index([clienteId])
}

// Arquivo original (PDF ou PPTX) mostrado "como está", página por página.
// Tabela separada de propósito: os bytes não pesam as queries de lista/relatório.
model Arquivo {
  id            Int         @id @default(autoincrement())
  treinamentoId Int         @unique
  treinamento   Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  mime          String // application/pdf | application/vnd.openxmlformats-officedocument.presentationml.presentation
  nomeOriginal  String
  dados         Bytes
}

// Um slide de um treinamento em formato apresentação (deck navegável).
model Slide {
  id            Int         @id @default(autoincrement())
  treinamentoId Int
  treinamento   Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  ordem         Int         @default(0)
  titulo        String
  conteudo      String // tópicos separados por quebra de linha

  @@index([treinamentoId])
}

// Pergunta de multipla escolha do quiz de um treinamento.
model Pergunta {
  id            Int           @id @default(autoincrement())
  treinamentoId Int
  treinamento   Treinamento   @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  enunciado     String
  ordem         Int           @default(0)
  alternativas  Alternativa[]

  @@index([treinamentoId])
}

model Alternativa {
  id         Int      @id @default(autoincrement())
  perguntaId Int
  pergunta   Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  texto      String
  correta    Boolean  @default(false)

  @@index([perguntaId])
}

model Atribuicao {
  id            Int           @id @default(autoincrement())
  treinamentoId Int
  treinamento   Treinamento   @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  usuarioId     Int
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  atribuidoEm   DateTime      @default(now())
  prazo         DateTime
  concluidoEm   DateTime?
  nota          Int? // % de acerto na ultima tentativa do quiz (null = sem quiz / nao tentou)
  ultimasRespostas Json? // { perguntaId: alternativaId } da ultima tentativa, p/ revisao
  ultimoLembrete DateTime? // ultimo email de lembrete enviado (dedup dos lembretes automaticos)
  notificacoes  Notificacao[]

  @@unique([treinamentoId, usuarioId])
  @@index([usuarioId])
}

// Log das "notificacoes por email" (simuladas no prototipo, reais com RESEND_API_KEY).
model Notificacao {
  id           Int        @id @default(autoincrement())
  atribuicaoId Int
  atribuicao   Atribuicao @relation(fields: [atribuicaoId], references: [id], onDelete: Cascade)
  tipo         String // "liberacao" | "lembrete" | "vencido"
  mensagem     String
  canal        String     @default("simulado") // "simulado" | "email"
  enviadoEm    DateTime   @default(now())

  @@index([atribuicaoId])
}
